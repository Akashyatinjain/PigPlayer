# ==========================================
# Soundify / PigPlayer Docker Environment Configuration
# ==========================================

# Node Environment
NODE_ENV=production

# Ports
PORT=5000
FRONTEND_PORT=3000

# Next.js Frontend Configuration
HOSTNAME=0.0.0.0
BACKEND_INTERNAL_URL=http://backend:5000
NEXT_PUBLIC_API_URL=/api

# CORS & Client URLs
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Persistent Data Storage (inside container)
DATA_ROOT=/app/data
SQLITE_PATH=/app/data/soundify.db

# JWT Secrets (replace with strong random strings for production deployments)
JWT_SECRET=change-this-to-a-very-secure-random-string-at-least-32-characters
JWT_REFRESH_SECRET=change-this-to-a-very-secure-refresh-string-at-least-32-characters

# Initial Admin/Local User Credentials
LOCAL_USER_EMAIL=local@soundify.app
LOCAL_USER_PASSWORD=soundify
LOCAL_USER_NAME=Local User

# Upload Limits (MB)
MAX_UPLOAD_MB=100

