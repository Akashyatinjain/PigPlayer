{
  "name": "soundify-backend",
  "version": "1.0.0",
  "description": "Soundify Music Player — Offline-first Express + SQLite API",
  "main": "server.js",
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "node --watch -r ts-node/register/transpile-only src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node scripts/prisma-cli.js",
    "db:migrate": "node scripts/migrate.js",
    "db:import-sqlite": "node scripts/import-sqlite.js",
    "prisma:push": "npm run db:migrate",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "cleanup:storage": "ts-node --project tsconfig.json --transpile-only ../scripts/cleanup-storage.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "music-metadata": "^12.8.3",
    "prisma": "^6.19.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.16.1",
    "@prisma/config": { "effect": "3.22.1", "deepmerge-ts": "8.0.0" }
  }
}
