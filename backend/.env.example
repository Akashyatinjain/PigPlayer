# Soundify Backend — Offline-first local configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=https://pig-player.vercel.app,http://localhost:3000

# Local SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:../../data/soundify.db"

# Local JWT secrets (change for multi-user machines)
JWT_SECRET="soundify-local-jwt-secret-offline-2026"
JWT_REFRESH_SECRET="soundify-local-refresh-secret-offline-2026"

# Default local user created on first run
LOCAL_USER_EMAIL=local@soundify.app
LOCAL_USER_PASSWORD=soundify
LOCAL_USER_NAME=Local User

# Upload limits
MAX_UPLOAD_MB=100
