NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=
TRUST_PROXY_HOPS=0

# Leave database overrides unset to use ../data/soundify.db. A relative file: URL is resolved
# from backend/prisma. SQLITE_PATH takes precedence over SQLITE_DATABASE_URL
# and DATABASE_URL.
# DATABASE_URL=file:../../data/soundify.db
# SQLITE_DATABASE_URL=
# SQLITE_PATH=
# DATA_ROOT=

# Use independent random secrets in production. Blank values use ephemeral keys locally.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional first-run administrator. Choose an unused email and a unique password.
LOCAL_USER_EMAIL=
LOCAL_USER_PASSWORD=
LOCAL_USER_NAME=Local User

ALLOW_GUEST_MUTATIONS=false
MAX_UPLOAD_MB=100
